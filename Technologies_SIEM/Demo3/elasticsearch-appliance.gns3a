{
    "appliance_id": "elasticsearch-graylog",
    "name": "Elasticsearch (Graylog)",
    "category": "guest",
    "description": "Elasticsearch for Graylog log storage and indexing",
    "vendor_name": "Elastic",
    "vendor_url": "https://www.elastic.co/",
    "documentation_url": "https://www.elastic.co/guide/en/elasticsearch/reference/6.x/",
    "product_name": "Elasticsearch OSS",
    "product_url": "https://hub.docker.com/r/docker.elastic.co/elasticsearch/elasticsearch-oss",
    "registry_version": 4,
    "status": "stable",
    "maintainer": "GNS3",
    "maintainer_email": "support@gns3.com",
    "usage": "Connect to Graylog container. Elasticsearch listens on port 9200 (HTTP) and 9300 (node communication).",
    "docker": {
        "image": "docker.elastic.co/elasticsearch/elasticsearch-oss:6.8.5",
        "adapters": 1,
        "console_type": "none",
        "start_command": "",
        "environment": "http.host=0.0.0.0\ntransport.host=localhost\nnetwork.host=0.0.0.0\nES_JAVA_OPTS=-Xms512m -Xmx512m\ndiscovery.type=single-node",
        "memory": 1024
    },
    "ports": [
        {
            "name": "HTTP",
            "port": 9200,
            "port_type": "tcp",
            "description": "Elasticsearch HTTP API"
        },
        {
            "name": "Node",
            "port": 9300,
            "port_type": "tcp",
            "description": "Elasticsearch node communication"
        }
    ]
}
