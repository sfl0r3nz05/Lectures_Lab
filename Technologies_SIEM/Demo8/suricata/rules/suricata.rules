# Modbus TCP port 5020 (CONPOT HONEYPOT) - Write Single Coil (FC 5) CRITICAL
alert tcp any any -> any 5020 (msg:"Modbus Write Single Coil (FC 5)"; content:"|00 00|"; offset:2; depth:2; byte_test:1,=,5,7; classtype:attempted-admin; sid:2000021; rev:2;)

# Modbus TCP port 5020 - Write Single Register (FC 6) CRITICAL  
alert tcp any any -> any 5020 (msg:"Modbus Write Single Register (FC 6)"; content:"|00 00|"; offset:2; depth:2; byte_test:1,=,6,7; classtype:attempted-admin; sid:2000022; rev:2;)

# Modbus Connection Attempt (Scanning)
alert tcp any any -> any 5020 (msg:"Modbus Connection Attempt"; flags:S; flow:to_server; classtype:network-scan; sid:2000050; rev:2;)

# Modbus Possible DoS
alert tcp any any -> any 5020 (msg:"Modbus Possible DoS"; threshold: type both, track by_src, count 5, seconds 5; classtype:attempted-dos; sid:2000051; rev:2;)

# Modbus FC 1 - Read Coils (Reconnaissance)
alert tcp any any -> any 5020 (msg:"Modbus Read Coils (FC 1)"; content:"|00 00|"; offset:2; depth:2; byte_test:1,=,1,7; classtype:network-scan; sid:2000011; rev:2;)

# Modbus FC 3 - Read Holding Registers (Reconnaissance)
alert tcp any any -> any 5020 (msg:"Modbus Read Holding Registers (FC 3)"; content:"|00 00|"; offset:2; depth:2; byte_test:1,=,3,7; classtype:network-scan; sid:2000013; rev:2;)